#!/usr/bin/env bash
# 指定した .cpp を AtCoder と同じ GCC 15 / C++23 でビルドし、同じディレクトリの test/ で oj t を実行する
#   contest/ABC/484/A.cpp の隣に test/ が無ければ practice/ABC/484/A/test を使う
#   使い方: scripts/test ABC/380/A/main.cpp
#           scripts/test --build-only ABC/380/A/main.cpp   # ビルドだけ（VS Code 拡張から使う）
set -euo pipefail

BUILD_ONLY=false
if [[ "${1:-}" == "--build-only" ]]; then
  BUILD_ONLY=true
  shift
fi

if [[ $# -ne 1 ]]; then
  echo "使い方: $0 [--build-only] <ソースファイル.cpp>" >&2
  exit 2
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$1"
DIR="$(cd "$(dirname "$SRC")" && pwd)"
BIN="$DIR/$(basename "${SRC%.*}").out"
TEST_DIR="$DIR/test"
# contest/<種類>/<番号>/<問題>.cpp の隣に test/ が無ければ、practice/ 側で取得したサンプルを使う
CONTEST_SRC="${DIR#"$REPO_ROOT"/}/$(basename "$SRC")"
if [[ ! -d "$TEST_DIR" && "$CONTEST_SRC" =~ ^contest/([A-Z]+/[0-9]+)/([A-Za-z0-9]+)\.cpp$ ]]; then
  PRACTICE_TEST="$REPO_ROOT/practice/${BASH_REMATCH[1]}/$(tr '[:lower:]' '[:upper:]' <<<"${BASH_REMATCH[2]}")/test"
  [[ -d "$PRACTICE_TEST" ]] && TEST_DIR="$PRACTICE_TEST"
fi
CXX="${CXX:-g++-15}"

command -v "$CXX" >/dev/null || { echo "エラー: $CXX がありません。scripts/setup-mac.sh を実行してください" >&2; exit 1; }

build() {
  "$CXX" -std=gnu++23 -O2 -Wall -Wextra -DLOCAL \
    -I "$REPO_ROOT/.lib/ac-library" -I "$REPO_ROOT/include" \
    "$SRC" -o "$BIN"
}

if $BUILD_ONLY; then
  build
  echo "$BIN"
  exit 0
fi

if [[ ! -d "$TEST_DIR" ]]; then
  echo "エラー: $TEST_DIR がありません。scripts/new <contest> で問題を取得してください" >&2
  exit 1
fi
command -v oj >/dev/null || { echo "エラー: oj がありません。scripts/setup-mac.sh を実行してください" >&2; exit 1; }

echo "==> build: $SRC"
build

echo "==> test: $TEST_DIR"
# AtCoder の公式ルール（空白文字の置き換え・追加は正解扱い）に合わせ、空白と改行を区別せずに比較する
oj test --command "$BIN" --directory "$TEST_DIR" --ignore-spaces-and-newlines
