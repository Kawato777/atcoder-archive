#!/usr/bin/env python3
"""問題のファイルを作る。

使い方:
    scripts/new abc380                # 過去問: 問題とサンプルを取得（ログイン不要）
    scripts/new abc380 a c            # 過去問: A と C だけ
    scripts/new --contest abc485      # コンテスト参加: base.cpp から A.cpp ... を作る（通信しない）
    scripts/new --contest abc485 h    # コンテスト参加: H.cpp だけ追加

過去問:         abc380 -> practice/ABC/380/A/main.cpp, practice/ABC/380/A/test/sample-*.{in,out}
コンテスト参加: abc485 -> contest/ABC/485/A.cpp ... G.cpp

コンテスト参加用の問題数は決め打ち（ABC: A-G, ARC/AGC: A-F, AHC: A）。
contest/ はコンテスト終了時点の状態を残す場所。終了後に解き直す (upsolve) ときは
--contest を付けずに取得して practice/ に置く。
"""

from __future__ import annotations

import re
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from html.parser import HTMLParser
from pathlib import Path

ATCODER = "https://atcoder.jp"
REPO_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = REPO_ROOT / "base.cpp"
SOURCE_NAME = "main.cpp"
TEST_DIR_NAME = "test"
PRACTICE_DIR = "practice"
CONTEST_DIR = "contest"
CONTEST_FLAG = "--contest"

# 番号付きのシリーズと、コンテスト参加時に作る問題（現行形式に合わせた決め打ち）
SERIES_PROBLEMS: dict[str, str] = {
    "abc": "ABCDEFG",
    "arc": "ABCDEF",
    "agc": "ABCDEF",
    "ahc": "A",
}
SERIES_ID = re.compile(rf"({'|'.join(SERIES_PROBLEMS)})(\d+)")


@dataclass(frozen=True)
class Task:
    label: str  # "A", "B", ..., "Ex"
    url: str


class TaskTableParser(HTMLParser):
    """/contests/<id>/tasks の表から (ラベル, URL) を集める。

    各行の先頭セルのリンクテキストが "A" などのラベル、href が問題ページ。
    """

    def __init__(self, contest_id: str) -> None:
        super().__init__()
        self._pattern = re.compile(rf"^/contests/{re.escape(contest_id)}/tasks/[^/]+$")
        self._href: str | None = None
        self._text = ""
        self.tasks: list[Task] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        href = dict(attrs).get("href")
        if tag == "a" and href is not None and self._pattern.match(href):
            self._href = href
            self._text = ""

    def handle_data(self, data: str) -> None:
        if self._href is not None:
            self._text += data

    def handle_endtag(self, tag: str) -> None:
        if tag != "a" or self._href is None:
            return
        url = ATCODER + self._href
        label = self._text.strip()
        # 同じ URL のリンクが「ラベル」「問題名」の 2 回出てくるので最初の 1 回だけ使う
        if label and all(t.url != url for t in self.tasks):
            self.tasks.append(Task(label=label, url=url))
        self._href = None


def http_error_message(url: str, code: int) -> str:
    if code == 429:
        return "エラー: AtCoder へのアクセスが多すぎます（HTTP 429）。1分ほど待ってから再実行してください"
    if code == 404:
        return f"エラー: {url} が見つかりません（HTTP 404）。コンテストIDを確認してください"
    return f"エラー: {url} の取得に失敗しました（HTTP {code}）"


def fetch(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": "atcoder-archive-practice"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        raise SystemExit(http_error_message(url, e.code)) from e
    except urllib.error.URLError as e:
        raise SystemExit(f"エラー: {url} に接続できません: {e.reason}") from e


def fetch_tasks(contest_id: str) -> list[Task]:
    parser = TaskTableParser(contest_id)
    parser.feed(fetch(f"{ATCODER}/contests/{contest_id}/tasks"))
    if not parser.tasks:
        raise SystemExit(f"エラー: {contest_id} の問題一覧が見つかりません（開催中で非公開の可能性があります）")
    return parser.tasks


def contest_dir(contest_id: str, participated: bool) -> Path:
    """ABC/ARC/AGC/AHC は 2 階層 (abc380 -> ABC/380)、それ以外は ID 全体を大文字 1 階層
    (typical90 -> TYPICAL90, hhkb2020 -> HHKB2020)。
    その上に参加した回なら contest/、過去問なら practice/ を付ける。"""
    m = SERIES_ID.fullmatch(contest_id)
    relative = Path(m[1].upper(), m[2]) if m else Path(contest_id.upper())
    return REPO_ROOT / (CONTEST_DIR if participated else PRACTICE_DIR) / relative


def select(tasks: list[Task], labels: list[str]) -> list[Task]:
    if not labels:
        return tasks
    wanted = {label.upper() for label in labels}
    unknown = wanted - {t.label.upper() for t in tasks}
    if unknown:
        raise SystemExit(f"エラー: 存在しない問題: {', '.join(sorted(unknown))}")
    return [t for t in tasks if t.label.upper() in wanted]


def create_source(task_dir: Path, task: Task) -> str:
    source = task_dir / SOURCE_NAME
    if source.exists():
        return "既存のため skip"
    source.write_text(f"// {task.url}\n{TEMPLATE.read_text()}")
    return "作成"


def download_samples(task_dir: Path, task: Task) -> str:
    test_dir = task_dir / TEST_DIR_NAME
    if test_dir.exists():
        return "既存のため skip"
    result = subprocess.run(
        ["oj", "download", task.url, "--directory", str(test_dir)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(result.stdout + result.stderr, file=sys.stderr)
        return "失敗"
    return f"{len(list(test_dir.glob('*.in')))} 件取得"


def new_practice(contest_id: str, labels: list[str]) -> int:
    """過去問: 問題一覧とサンプルを取得して <問題>/main.cpp と <問題>/test/ を作る"""
    tasks = select(fetch_tasks(contest_id), labels)
    base = contest_dir(contest_id, participated=False)
    failed = False
    for task in tasks:
        task_dir = base / task.label
        task_dir.mkdir(parents=True, exist_ok=True)
        src = create_source(task_dir, task)
        samples = download_samples(task_dir, task)
        failed |= samples == "失敗"
        print(f"{task.label:>3}: {task_dir.relative_to(REPO_ROOT)}/{SOURCE_NAME} ({src}), サンプル: {samples}")
    return 1 if failed else 0


def new_contest(contest_id: str, labels: list[str]) -> int:
    """コンテスト参加: 通信せず base.cpp から <問題>.cpp を作る（contest/ABC/484 と同じ形）"""
    m = SERIES_ID.fullmatch(contest_id)
    if m is None:
        series = ", ".join(s.upper() for s in SERIES_PROBLEMS)
        raise SystemExit(f"エラー: コンテスト用の作成は {series} だけに対応しています（例: abc485）")
    problems = [label.upper() for label in labels] or list(SERIES_PROBLEMS[m[1]])
    if not all(re.fullmatch(r"[A-Z0-9]+", p) for p in problems):
        raise SystemExit(f"エラー: 問題は英数字で指定してください: {' '.join(problems)}")

    base = contest_dir(contest_id, participated=True)
    base.mkdir(parents=True, exist_ok=True)
    template = TEMPLATE.read_text()
    for label in problems:
        source = base / f"{label}.cpp"
        status = "既存のため skip" if source.exists() else "作成"
        if status == "作成":
            source.write_text(template)
        print(f"{label:>3}: {source.relative_to(REPO_ROOT)} ({status})")
    return 0


def main(argv: list[str]) -> int:
    participated = CONTEST_FLAG in argv
    positional = [a for a in argv if a != CONTEST_FLAG]
    unknown_flags = [a for a in positional if a.startswith("-")]
    if unknown_flags:
        raise SystemExit(f"エラー: 不明なオプション: {', '.join(unknown_flags)}（使えるのは {CONTEST_FLAG} だけ）")
    if not positional:
        print(__doc__, file=sys.stderr)
        return 2
    contest_id, labels = positional[0].lower(), positional[1:]
    return new_contest(contest_id, labels) if participated else new_practice(contest_id, labels)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
