#!/usr/bin/env python3
"""問題の解法ノート (note.md) を base-note.md から作る。既にあれば上書きしない。

使い方:
    scripts/note practice/ABC/484/E            # 問題のディレクトリ
    scripts/note practice/ABC/484/E/main.cpp   # main.cpp でもよい
    scripts/note contest/ABC/484/E.cpp         # 参加した回 -> practice/ABC/484/E/note.md に作る
    scripts/note --status 自力AC --tags DP,二分探索 --time "O(N log N)" --space "O(N)" --review practice/ABC/484/E
    scripts/note --info practice/ABC/484/E     # 作らずに場所・有無・既存のタグを JSON で出す
    scripts/note --apply practice/ABC/484/E    # Claude（atcoder-review）の出力をクリップボードから取り込む
    scripts/note --apply --from out.md practice/ABC/484/E   # ファイルから（--from - は標準入力）
    scripts/note --apply --dry-run --from out.md practice/ABC/484/E   # 書き込まず、取り込み後の全文を出す
    scripts/note --history                     # practice/ の全ノートの path / url / status / tags を JSON で出す

--status / --tags / --time / --space / --review は新しく作るときだけ frontmatter に入る（既存のノートは変えない）。

--apply は、先頭の frontmatter と「## Claude による添削・解説（AI生成）」の見出しがある内容だけを受け付ける。
  - frontmatter は tags / time / space / review だけを見る（status は変えない）。
    今の値が空のキーだけ埋め、値が入っているキーは差分を出すだけ（--overwrite で上書き）。
    review は false を空とみなす。
  - 見出しから末尾までの節は、note.md に既にあれば置き換え、無ければ末尾に追加する。見出しより上の本文は変えない。
  - contest/ の解答を指定したとき（または見出しが「## Claude による添削・解説（AI生成・本番）」のとき）は
    本番の節として扱う。本番の節と practice/ の節（復習）は別々に置き換え、もう一方は残す。
  - 節の先頭（日付コメントの次の行）に、添削したコードへの相対リンク「対象: [...](...)」を入れる。
    contest/ を指定したときは contest/ の .cpp、practice/ を指定したときは main.cpp へのリンク。
  - note.md が無ければ先に作る。要約は標準エラー出力に、結果は標準出力に JSON で出す。
  - --dry-run では何も書き込まず、取り込み後の note.md の全文を標準出力に出す（要約は標準エラー出力）。

--history は practice/ 以下の全ての note.md について {path, url, status, tags} の配列を JSON で出す。
  path はリポジトリ相対。url は frontmatter の url: か main.cpp の 1 行目のコメントから取る（無ければ null）。

contest/ はコンテスト終了時点の状態を残す場所なので、ノートは practice/ 側に作る。
practice/ 側に main.cpp が無いときは、問題URLを frontmatter の url: に書く。
A.cpp を直接置く古い形式（practice/ABC/483/A.cpp など）は対象外。

作成したか既存だったかは標準エラー出力に、note.md の絶対パスは標準出力の最後の行に出す。
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import unicodedata
from collections import Counter
from pathlib import Path

ATCODER = "https://atcoder.jp"
REPO_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = REPO_ROOT / "base-note.md"
NOTE_NAME = "note.md"
SOURCE_NAME = "main.cpp"
PRACTICE_DIR = "practice"
CONTEST_DIR = "contest"
# scripts/new --contest が作る contest/<シリーズ>/<番号>/<問題>.cpp
CONTEST_SOURCE = re.compile(r"(ABC|ARC|AGC|AHC)/(\d+)/([A-Za-z0-9]+)\.cpp")
STATUSES = ("本番AC", "自力AC", "解説AC", "未AC")
# frontmatter の "tags: [DP, 二分探索]" の行
TAGS_LINE = re.compile(r"^tags:\s*\[(.*?)\]", re.MULTILINE)
# frontmatter の値に入れると YAML として壊れる文字
# base-note.md でコメント (#) が始まる列
COMMENT_COLUMN = 22
UNSAFE_VALUE = re.compile(r"[#\[\],]|:\s|:$|^\s|\s$")

LEGACY_MESSAGE = (
    "エラー: {path} は A.cpp を直接置く古い形式なので対象外です"
    "（ノートは practice/<種類>/<番号>/<問題>/ の形式だけで作れます）"
)


def to_repo_relative(arg: str) -> Path:
    path = Path(arg).resolve()
    try:
        return path.relative_to(REPO_ROOT)
    except ValueError:
        raise SystemExit(f"エラー: {arg} はリポジトリ ({REPO_ROOT}) の外です") from None


def contest_target(relative: Path) -> tuple[Path, str]:
    """contest/ABC/484/E.cpp -> (practice/ABC/484/E, 問題URL)"""
    inner = relative.relative_to(CONTEST_DIR).as_posix()
    m = CONTEST_SOURCE.fullmatch(inner)
    if m is None:
        raise SystemExit(
            f"エラー: {relative} からノートの場所を決められません。"
            f"contest/ では問題のファイル（例: {CONTEST_DIR}/ABC/484/E.cpp）を指定してください"
        )
    series, number, label = m[1], m[2], m[3].upper()
    contest_id = f"{series.lower()}{number}"
    url = f"{ATCODER}/contests/{contest_id}/tasks/{contest_id}_{label.lower()}"
    return Path(PRACTICE_DIR, series, number, label), url


def practice_target(relative: Path) -> Path:
    """practice/ABC/484/E または practice/ABC/484/E/main.cpp -> practice/ABC/484/E"""
    absolute = REPO_ROOT / relative
    if absolute.is_file():
        if absolute.name != SOURCE_NAME:
            raise SystemExit(LEGACY_MESSAGE.format(path=relative))
        return relative.parent
    if not absolute.is_dir():
        raise SystemExit(f"エラー: {relative} が見つかりません")
    # contest/ から作ったノートだけがあるディレクトリも問題のディレクトリとみなす
    if not (absolute / SOURCE_NAME).exists() and not (absolute / NOTE_NAME).exists():
        raise SystemExit(f"エラー: {relative} に {SOURCE_NAME} がありません。問題のディレクトリを指定してください")
    return relative


def resolve(arg: str) -> tuple[Path, str | None]:
    """指定されたパス -> (ノートを置く問題のディレクトリ（リポジトリ相対）, contest/ から来たときの問題URL)"""
    relative = to_repo_relative(arg)
    top = relative.parts[0] if relative.parts else ""
    if top == CONTEST_DIR:
        return contest_target(relative)
    if top == PRACTICE_DIR:
        return practice_target(relative), None
    raise SystemExit(f"エラー: {arg} は {PRACTICE_DIR}/ か {CONTEST_DIR}/ の下を指定してください")


def parse_tags(text: str) -> list[str]:
    """"DP, 二分探索" / "DP、二分探索" -> ["DP", "二分探索"]（空は除き、重複は最初の 1 つだけ残す）"""
    tags = [t.strip() for t in re.split(r"[,、]", text)]
    return list(dict.fromkeys(t for t in tags if t))


def validate(key: str, value: str) -> str:
    if UNSAFE_VALUE.search(value):
        raise SystemExit(f"エラー: {key} に # [ ] , と「: 」、前後の空白は使えません: {value!r}")
    return value


def display_width(text: str) -> int:
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def set_field(text: str, key: str, value: str) -> str:
    """"status:               # コメント" の値だけを置き換え、コメントは残す"""
    pattern = re.compile(rf"^{key}:[^#\n]*?(\s*#.*)?$", re.MULTILINE)
    if pattern.search(text) is None:
        raise SystemExit(f"エラー: {TEMPLATE.name} に {key}: の行がありません")

    def replace(m: re.Match[str]) -> str:
        comment = (m[1] or "").strip()
        field = f"{key}: {value}"
        # 雛形と同じく、コメントの位置をそろえる（全角文字は幅 2 として数える）
        padding = " " * max(COMMENT_COLUMN - display_width(field), 1)
        return f"{field}{padding}{comment}" if comment else field

    return pattern.sub(replace, text, count=1)


def render(url: str | None, fields: dict[str, str]) -> str:
    text = TEMPLATE.read_text()
    for key, value in fields.items():
        text = set_field(text, key, value)
    if url is None:
        return text
    # 先頭の "---" の直後に url: を入れる
    head, rest = text.split("\n", 1)
    return f"{head}\nurl: {url}\n{rest}"


def frontmatter_fields(args: argparse.Namespace) -> dict[str, str]:
    fields: dict[str, str] = {}
    if args.status is not None:
        fields["status"] = args.status
    if args.tags is not None:
        tags = [validate("tags", t) for t in parse_tags(args.tags)]
        fields["tags"] = f"[{', '.join(tags)}]"
    for key in ("time", "space"):
        value: str | None = getattr(args, key)
        if value is not None and value.strip():
            fields[key] = validate(key, value.strip())
    if args.review:
        fields["review"] = "true"
    return fields


def existing_tags() -> list[str]:
    """practice/ 以下のノートで使われているタグ（使われている回数が多い順）"""
    counts: Counter[str] = Counter()
    for note in (REPO_ROOT / PRACTICE_DIR).rglob(NOTE_NAME):
        m = TAGS_LINE.search(note.read_text())
        if m:
            counts.update(parse_tags(m[1]))
    return [tag for tag, _ in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]


def note_url(note: Path, fm: dict[str, str]) -> str | None:
    """frontmatter の url:、無ければ main.cpp の 1 行目のコメントの URL"""
    if fm.get("url"):
        return fm["url"]
    source = note.parent / SOURCE_NAME
    if not source.exists():
        return None
    with source.open(encoding="utf-8", errors="replace") as f:
        m = re.search(r"https://atcoder\.jp/\S+", f.readline())
    return m[0] if m else None


def history() -> list[dict[str, object]]:
    """practice/ 以下の全ノートの path / url / status / tags（path の順）"""
    entries: list[dict[str, object]] = []
    for note in sorted((REPO_ROOT / PRACTICE_DIR).rglob(NOTE_NAME)):
        split = split_frontmatter(note.read_text(encoding="utf-8").replace("\r\n", "\n"))
        fm = {
            line.split(":", 1)[0].strip(): frontmatter_value(line)
            for line in (split[0] if split else [])
            if ":" in line and not line.lstrip().startswith("#")
        }
        tags = fm.get("tags", "")
        entries.append(
            {
                "path": note.relative_to(REPO_ROOT).as_posix(),
                "url": note_url(note, fm),
                "status": fm.get("status") or None,
                "tags": parse_tags(tags.strip("[]")) if tags.startswith("[") else [],
            }
        )
    return entries


# --- --apply: Claude（atcoder-review）の出力の取り込み ---

AI_HEADING = "## Claude による添削・解説（AI生成）"
# contest/ の解答（本番のコード）への添削。practice/ の節（復習）とは別に残す
AI_HEADING_CONTEST = "## Claude による添削・解説（AI生成・本番）"
AI_HEADINGS = (AI_HEADING_CONTEST, AI_HEADING)
APPLY_KEYS = ("tags", "time", "space", "review")
FENCE = re.compile(r"^\s{0,3}(```|~~~)")


def read_apply_input(source: str | None) -> str:
    """--from の指定（None: クリップボード、"-": 標準入力、それ以外: ファイル）から読む"""
    if source == "-":
        text = sys.stdin.buffer.read().decode("utf-8")
    elif source is not None:
        try:
            text = Path(source).read_text(encoding="utf-8")
        except OSError as e:
            raise SystemExit(f"エラー: {source} を読めません: {e.strerror}") from None
    else:
        # LANG が無いと pbpaste は日本語を化けさせるので UTF-8 を指定する
        env = {**os.environ, "LANG": "en_US.UTF-8", "LC_CTYPE": "UTF-8"}
        try:
            result = subprocess.run(["pbpaste"], capture_output=True, env=env, check=False)
        except FileNotFoundError:
            raise SystemExit("エラー: pbpaste がありません（macOS 以外）。--from <ファイル> か --from - で渡してください") from None
        if result.returncode != 0:
            raise SystemExit(f"エラー: pbpaste が失敗しました: {result.stderr.decode('utf-8', 'replace').strip()}")
        text = result.stdout.decode("utf-8")
    return text.lstrip("﻿").replace("\r\n", "\n")


def split_frontmatter(text: str) -> tuple[list[str], str] | None:
    """先頭の "---" から次の "---" までの行と、その後ろの本文。frontmatter が無ければ None"""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1 :])
    return None


def find_headings(text: str) -> list[tuple[int, str]]:
    """コードブロックの外で、行頭に AI_HEADINGS のどれかがある位置（文字オフセット）と見出し"""
    found: list[tuple[int, str]] = []
    offset = 0
    in_fence = False
    for line in text.splitlines(keepends=True):
        if FENCE.match(line):
            in_fence = not in_fence
        elif not in_fence and line.rstrip() in AI_HEADINGS:
            found.append((offset, line.rstrip()))
        offset += len(line)
    return found


def frontmatter_value(line: str) -> str:
    """"key: 値   # コメント" -> "値" """
    return re.sub(r"\s+#.*$", "", line.split(":", 1)[1]).strip()


def normalize_claude_value(key: str, value: str) -> str | None:
    """Claude の値を note.md に書く形にする。空なら None"""
    if key == "tags":
        m = re.fullmatch(r"\[(.*)\]", value)
        if m is None:
            raise SystemExit(f"エラー: 取り込む内容の tags が [A, B] の形ではありません: {value!r}")
        tags = [validate("tags", t) for t in parse_tags(m[1])]
        return f"[{', '.join(tags)}]" if tags else None
    if key == "review":
        if value.lower() not in ("true", "false"):
            raise SystemExit(f"エラー: 取り込む内容の review は true か false にしてください: {value!r}")
        return value.lower()
    return validate(key, value) if value else None


def parse_claude_output(text: str) -> tuple[dict[str, str], list[str], str]:
    """-> (取り込む frontmatter の値, 無視したキー, 見出しから末尾までの節)"""
    split = split_frontmatter(text.lstrip("\n"))
    if split is None:
        raise SystemExit(
            "エラー: 取り込む内容の先頭に frontmatter（--- で囲んだ部分）がありません。"
            "Claude の出力をそのままコピーしてください（何も変更していません）"
        )
    fm_lines, body = split
    headings = find_headings(body)
    if not headings:
        raise SystemExit(f"エラー: 取り込む内容に「{AI_HEADING}」の見出しがありません（何も変更していません）")
    heading = headings[0][0]

    fields: dict[str, str] = {}
    ignored: list[str] = []
    for line in fm_lines:
        if not line.strip() or line.lstrip().startswith("#") or ":" not in line:
            continue
        key = line.split(":", 1)[0].strip()
        if key not in APPLY_KEYS:
            ignored.append(key)
            continue
        value = normalize_claude_value(key, frontmatter_value(line))
        if value is not None:
            fields[key] = value
    return fields, ignored, body[heading:].rstrip() + "\n"


def is_empty(key: str, value: str) -> bool:
    if key == "tags":
        return value.strip("[] ") == ""
    if key == "review":
        return value in ("", "false")
    return value == ""


def same_value(key: str, a: str, b: str) -> bool:
    if key == "tags":
        return parse_tags(a.strip("[]")) == parse_tags(b.strip("[]"))
    return a == b


def apply_frontmatter(
    text: str, fields: dict[str, str], overwrite: bool, note_label: str
) -> tuple[str, dict[str, list[str]], list[dict[str, str]]]:
    """-> (新しい note.md, {"filled"|"overwritten"|"unchanged": キー}, 変えなかったキーと差分)"""
    split = split_frontmatter(text)
    if split is None:
        raise SystemExit(f"エラー: {note_label} の先頭に frontmatter がありません")
    current = {
        line.split(":", 1)[0]: frontmatter_value(line)
        for line in split[0]
        if re.match(rf"^({'|'.join(APPLY_KEYS)}):", line)
    }
    result: dict[str, list[str]] = {"filled": [], "overwritten": [], "unchanged": []}
    kept: list[dict[str, str]] = []
    for key, proposed in fields.items():
        if key not in current:
            raise SystemExit(f"エラー: {note_label} の frontmatter に {key}: の行がありません（何も変更していません）")
        now = current[key]
        if same_value(key, now, proposed):
            result["unchanged"].append(key)
        elif is_empty(key, now) or overwrite:
            text = set_field(text, key, proposed)
            result["overwritten" if not is_empty(key, now) else "filled"].append(key)
        else:
            kept.append({"key": key, "current": now, "proposed": proposed})
    return text, result, kept


def with_heading(section: str, heading: str) -> str:
    """節の 1 行目（見出し）を heading にする"""
    return heading + section[section.index("\n") :] if "\n" in section else heading + "\n"


LINK_PREFIX = "対象: "


def with_link(section: str, link: tuple[str, str]) -> str:
    """見出し（と日付コメント）の次の行を "対象: [表示](相対パス)" にする。既にあれば置き換える"""
    label, href = link
    lines = section.split("\n")
    head = 2 if len(lines) > 1 and lines[1].lstrip().startswith("<!--") else 1
    rest = lines[head:]
    if rest and rest[0].startswith(LINK_PREFIX):
        rest = rest[1:]
    return "\n".join([*lines[:head], f"{LINK_PREFIX}[{label}]({href})", *rest])


def existing_link(text: str, heading: str) -> tuple[str, str] | None:
    """note.md の heading の節にあるリンク (表示, 相対パス)。無ければ None"""
    found = find_headings(text)
    ends = [offset for offset, _ in found[1:]] + [len(text)]
    for (offset, h), end in zip(found, ends):
        if h == heading:
            lines = text[offset:end].split("\n")[1:3]
            m = next((re.fullmatch(r"対象: \[(.*)\]\((.*)\)", l) for l in lines if l.startswith(LINK_PREFIX)), None)
            return (m[1], m[2]) if m else None
    return None


def source_link(note: Path, source: Path) -> tuple[str, str]:
    """note.md から source へのリンクの (表示, 相対パス)。表示は practice/ の main.cpp ならファイル名、それ以外はリポジトリ相対"""
    href = Path(os.path.relpath(source, note.parent)).as_posix()
    label = href if source.parent == note.parent else source.relative_to(REPO_ROOT).as_posix()
    return label, href


def apply_section(text: str, section: str, contest: bool) -> tuple[str, str]:
    """-> (新しい note.md, "replaced" | "added")

    AI の節は見出しごとに 1 つ。同じ見出しの節（次の AI の節の手前まで）だけを置き換え、ほかの節は残す。
    無ければ、本番の節は復習の節の手前に、復習の節は末尾に追加する。"""
    heading = AI_HEADING_CONTEST if contest else AI_HEADING
    section = with_heading(section, heading)
    found = find_headings(text)
    starts = [offset for offset, _ in found] + [len(text)]
    for i, (offset, h) in enumerate(found):
        if h == heading:
            rest = text[starts[i + 1] :]
            return text[:offset] + section + ("\n" + rest if rest else ""), "replaced"
    practice = next((offset for offset, h in found if h == AI_HEADING), None)
    if contest and practice is not None:
        return text[:practice] + section + "\n" + text[practice:], "added"
    if not text.endswith("\n"):
        text += "\n"
    if not text.endswith("\n\n"):
        text += "\n"
    return text + section, "added"


def apply_note(args: argparse.Namespace, note: Path, url: str | None, contest_source: Path | None) -> int:
    # 不正な入力でノートを作ってしまわないよう、先に検証する
    fields, ignored, section = parse_claude_output(read_apply_input(args.source))
    label = str(note.relative_to(REPO_ROOT))

    created = not note.exists()
    if created:
        has_source = (note.parent / SOURCE_NAME).exists()
        original = render(None if has_source else url, frontmatter_fields(args))
    else:
        original = note.read_text(encoding="utf-8")

    text, result, kept = apply_frontmatter(original, fields, args.overwrite, label)
    contest = contest_source is not None or section.startswith(AI_HEADING_CONTEST)
    # リンク先: contest/ を指定したらその .cpp、practice/ なら main.cpp。
    # practice/ を指定して本番の見出しの内容を取り込んだときは、どのコードか分からないので今のリンクを引き継ぐ
    source = contest_source if contest_source is not None else None if contest else note.parent / SOURCE_NAME
    link = (
        source_link(note, source)
        if source is not None and source.exists()
        else existing_link(text, AI_HEADING_CONTEST if contest else AI_HEADING)
    )
    if link is not None:
        section = with_link(section, link)
    text, section_status = apply_section(text, section, contest)
    if not args.dry_run and (created or text != original):
        note.parent.mkdir(parents=True, exist_ok=True)
        note.write_text(text, encoding="utf-8")

    action = "作成して取り込み" if created else "取り込み"
    lines = [f"{label} ({action}{'。--dry-run なので書き込んでいません' if args.dry_run else ''})"]
    if result["filled"]:
        lines.append(f"  埋めたキー: {', '.join(result['filled'])}")
    if result["overwritten"]:
        lines.append(f"  上書きしたキー: {', '.join(result['overwritten'])}")
    if result["unchanged"]:
        lines.append(f"  同じ値だったキー: {', '.join(result['unchanged'])}")
    if kept:
        lines.append("  変えなかったキー（--overwrite で上書き）:")
        lines += [f"    {k['key']}: {k['current']} -> {k['proposed']}" for k in kept]
    if ignored:
        lines.append(f"  無視したキー: {', '.join(ignored)}")
    heading = AI_HEADING_CONTEST if contest else AI_HEADING
    lines.append(f"  「{heading}」の節を{'置き換えました' if section_status == 'replaced' else '追加しました'}")
    print("\n".join(lines), file=sys.stderr)
    if args.dry_run:
        sys.stdout.write(text)
        return 0
    print(
        json.dumps(
            {"note": str(note), "created": created, **result, "kept": kept, "ignored": ignored, "section": section_status},
            ensure_ascii=False,
        )
    )
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="scripts/note", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("path", nargs="?", help="問題のディレクトリ、main.cpp、または contest/ の <問題>.cpp")
    parser.add_argument("--info", action="store_true", help="作らずに場所・有無・既存のタグを JSON で出す")
    parser.add_argument("--status", choices=STATUSES)
    parser.add_argument("--tags", help="カンマ区切り（例: DP,二分探索）")
    parser.add_argument("--time", help="時間計算量（例: O(N log N)）")
    parser.add_argument("--space", help="空間計算量（例: O(N)）")
    parser.add_argument("--review", action="store_true", help="review: true にする")
    parser.add_argument("--apply", action="store_true", help="Claude（atcoder-review）の出力を note.md に取り込む")
    parser.add_argument("--from", dest="source", help="--apply で読む内容のファイル（- は標準入力。省略時はクリップボード）")
    parser.add_argument("--overwrite", action="store_true", help="--apply で、値が入っているキーも上書きする")
    parser.add_argument("--dry-run", action="store_true", help="--apply で、書き込まずに取り込み後の全文を標準出力に出す")
    parser.add_argument("--history", action="store_true", help="practice/ の全ノートの path / url / status / tags を JSON で出す")
    args = parser.parse_args(argv)
    if args.history:
        if args.path is not None or args.apply or args.info:
            parser.error("--history は単独で使ってください（パスは不要）")
        return args
    if args.path is None:
        parser.error("パスを指定してください")
    if args.apply and args.info:
        parser.error("--apply と --info は同時に使えません")
    if not args.apply and (args.source is not None or args.overwrite or args.dry_run):
        parser.error("--from / --overwrite / --dry-run は --apply と一緒に使ってください")
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.history:
        print(json.dumps(history(), ensure_ascii=False))
        return 0
    problem_dir, url = resolve(args.path)
    absolute_dir = REPO_ROOT / problem_dir
    note = absolute_dir / NOTE_NAME

    if args.info:
        print(json.dumps({"note": str(note), "exists": note.exists(), "tags": existing_tags()}, ensure_ascii=False))
        return 0

    if args.apply:
        # resolve は contest/ を指定したときだけ url を返す
        contest_source = REPO_ROOT / to_repo_relative(args.path) if url is not None else None
        return apply_note(args, note, url, contest_source)

    fields = frontmatter_fields(args)
    if note.exists():
        status = "既存" + ("。指定した status / tags などは反映していません" if fields else "")
    else:
        absolute_dir.mkdir(parents=True, exist_ok=True)
        has_source = (absolute_dir / SOURCE_NAME).exists()
        note.write_text(render(None if has_source else url, fields))
        status = "作成"
    print(f"{note.relative_to(REPO_ROOT)} ({status})", file=sys.stderr)
    print(note)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
