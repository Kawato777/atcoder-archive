{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=gnu++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-DLOCAL",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.out"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build & run",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}.out",
      "dependsOn": "build",
      "presentation": { "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
